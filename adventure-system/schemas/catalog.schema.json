{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Adventure catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalogVersion", "adventures"],
  "properties": {
    "catalogVersion": {"type": "integer", "const": 1},
    "adventures": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "name", "description", "author", "language", "type", "location", "estimatedMinutes", "minimumAge", "coverUrl", "downloadUrl", "packageSize", "sha256"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "author": {"type": "string", "minLength": 1},
        "language": {"type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"},
        "type": {"type": "string", "enum": ["linear", "circular", "nonlinear", "non-linear"]},
        "location": {"type": "string", "minLength": 1},
        "estimatedMinutes": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "minimumAge": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "coverUrl": {"type": "string", "pattern": "^https://", "minLength": 1},
        "downloadUrl": {"type": "string", "pattern": "^https://", "minLength": 1},
        "packageSize": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
      }
    }}
  }
}
