{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Engine-compatible adventure data v1",
  "type": "object", "additionalProperties": false,
  "required": ["formatVersion", "encounters", "items", "questDisplayNames"],
  "properties": {
    "formatVersion": {"type": "integer", "const": 1},
    "encounters": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/owner"}},
    "items": {"type": "object", "additionalProperties": {"$ref": "#/$defs/owner"}},
    "questDisplayNames": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "knowledgeFolders": {"type": "object", "additionalProperties": {"type": "string"}},
    "thingsIKnow": {"type": "object", "additionalProperties": {
      "type": "object", "additionalProperties": false, "required": ["text", "folder"],
      "properties": {"text": {"type": "string", "minLength": 1}, "folder": {"type": "string", "minLength": 1}}
    }},
    "progression": {
      "type": "object", "additionalProperties": false,
      "required": ["eligibleStarts", "trackVisits", "visitConditions"],
      "properties": {
        "eligibleStarts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9]{2}$"}},
        "trackVisits": {"type": "boolean", "const": true},
        "visitConditions": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["qr", "minimumVisits"],
          "properties": {
            "qr": {"type": "string", "pattern": "^[0-9]{2}$"},
            "minimumVisits": {"type": "integer", "minimum": 1}
          }
        }}
      }
    }
  },
  "$defs": {
    "owner": {
      "type": "object", "additionalProperties": false, "required": ["startPage", "pages"],
      "properties": {
        "startPage": {"type": "string", "pattern": "^[0-9]{4}$"},
        "displayName": {"type": "string"},
        "defaultPicture": {"type": "string", "minLength": 1},
        "requiredArea": {"type": "string", "minLength": 1},
        "pages": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/page"}}
      }
    },
    "page": {
      "type": "object", "additionalProperties": false, "required": ["id", "speaker", "text", "buttons", "actions", "condition"],
      "properties": {
        "id": {"type": "string", "pattern": "^[0-9]{4}$"},
        "speaker": {"type": "string"}, "text": {"type": "string"},
        "picture": {"type": "string", "minLength": 1},
        "condition": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
        "buttons": {"type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false, "required": ["index", "label", "next"],
          "properties": {
            "index": {"type": "integer", "minimum": 1},
            "label": {"type": "string", "minLength": 1}, "next": {"type": "string", "minLength": 1}
          }
        }},
        "actions": {"type": "array", "items": {"$ref": "#/$defs/action"}}
      }
    },
    "action": {
      "type": "object", "additionalProperties": false, "required": ["type"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "data": {"type": "string", "minLength": 1},
        "item": {"type": "string", "minLength": 1},
        "amount": {"type": "number"}, "value": {"type": "number"},
        "durationMs": {"type": "number", "minimum": 1},
        "buttonIndex": {},
        "unlessHasItem": {"type": "string", "minLength": 1},
        "waitPage": {"type": "string", "minLength": 1},
        "otherNext": {"type": "string", "minLength": 1},
        "options": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["label", "next"],
          "properties": {
            "label": {"type": "string", "minLength": 1},
            "value": {"type": "string", "minLength": 1},
            "next": {"type": "string", "minLength": 1}
          }
        }}
      }
    }
  }
}
